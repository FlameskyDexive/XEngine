<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>XEngine.Ads.Tests</RootNamespace>
    <AssemblyName>XEngine.Ads.Tests</AssemblyName>
    <BaseOutputPath>$(RepoRoot)Build\AdsTests\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(RepoRoot)Build\AdsTests\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.0" />
    <PackageReference Include="Xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\XEngine.Runtime\XEngine.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Runtime\**\*.cs" Link="Runtime\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Editor-side patcher has no editor-service dependencies and is tested standalone. -->
    <Compile Include="..\Editor\Build\AdsStageProjectPatcher.cs" Link="Editor\AdsStageProjectPatcher.cs" />
    <!-- The sample component compiles with the package to keep it honest. -->
    <Compile Include="..\Samples~\AdsDemo\Scripts\**\*.cs" Link="Samples\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
