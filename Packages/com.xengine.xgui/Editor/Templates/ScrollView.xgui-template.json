      { "id": "vertical", "name": "Scrollbar Vertical", "rect": { "anchorMin": [1, 0], "anchorMax": [1, 1], "pivot": [1, 0.5], "size": [12, -12], "position": [0, 6] }, "components": [ { "type": "Image", "properties": { "Color": [0.10, 0.10, 0.13, 1] } }, { "type": "Scrollbar", "properties": { "Direction": "TopToBottom", "Size": 0.3 } } ], "children": [ { "id": "verticalHandle", "name": "Handle", "rect": { "stretch": true }, "components": [ { "type": "Image", "properties": { "Color": [0.42, 0.42, 0.48, 1], "RaycastTarget": false } } ] } ] },
      { "id": "horizontal", "name": "Scrollbar Horizontal", "rect": { "anchorMin": [0, 0], "anchorMax": [1, 0], "pivot": [0.5, 0], "size": [-12, 12], "position": [-6, 0] }, "components": [ { "type": "Image", "properties": { "Color": [0.10, 0.10, 0.13, 1] } }, { "type": "Scrollbar", "properties": { "Direction": "LeftToRight", "Size": 0.3 } } ], "children": [ { "id": "horizontalHandle", "name": "Handle", "rect": { "stretch": true }, "components": [ { "type": "Image", "properties": { "Color": [0.42, 0.42, 0.48, 1], "RaycastTarget": false } } ] } ] }
