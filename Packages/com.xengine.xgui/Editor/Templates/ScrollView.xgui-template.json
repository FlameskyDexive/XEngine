    { "node": "scrollView", "component": "ScrollRect", "property": "Content", "targetNode": "content", "targetComponent": "RectTransform" },
    { "node": "scrollView", "component": "ScrollRect", "property": "VerticalScrollbar", "targetNode": "vertical", "targetComponent": "Scrollbar" },
