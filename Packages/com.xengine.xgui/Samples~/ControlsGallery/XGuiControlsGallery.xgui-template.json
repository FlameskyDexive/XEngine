{
  "root": {
    "id": "canvas",
    "name": "XGUI Gallery Canvas",
    "rect": { "stretch": true },
    "components": [ { "type": "GameCanvas" } ],
    "children": [
      {
        "id": "panel",
        "name": "Panel",
        "rect": { "size": [720, 420] },
        "components": [
          { "type": "Image", "properties": { "Color": [0.12, 0.13, 0.16, 1], "Type": "Sliced" } },
          { "type": "VerticalLayoutGroup", "properties": { "Padding": [24, 24, 24, 24], "Spacing": 12 } }
        ],
        "children": [
          {
            "id": "title",
            "name": "Title",
            "rect": { "size": [672, 36] },
            "components": [ { "type": "Text", "properties": { "TextValue": "XGUI Controls Gallery", "Size": 24 } } ]
          },
          {
            "id": "body",
            "name": "Body",
            "rect": { "size": [672, 72] },
            "components": [ { "type": "Text", "properties": { "TextValue": "Image, Text, Button, InputField and a layout row on one Overlay Canvas.", "Size": 16, "HorizontalOverflow": "Wrap" } } ]
          },
          {
            "id": "rich",
            "name": "Rich Text",
            "rect": { "size": [672, 48] },
            "components": [ {
              "type": "Text",
              "properties": {
                "TextValue": "Rich: <b>bold</b> <color=#6cf>color</color> <link=\"demo\">link</link> <mark=#ff0a>mark</mark>",
                "Size": 16,
                "RichTextEnabled": true,
                "HorizontalOverflow": "Wrap"
              }
            } ]
          },
          {
            "id": "button",
            "name": "Button",
            "rect": { "size": [180, 44] },
            "components": [ { "type": "Image", "properties": { "Color": [0.20, 0.45, 0.72, 1] } }, { "type": "Button" } ],
            "children": [
              { "id": "buttonLabel", "name": "Label", "rect": { "stretch": true }, "components": [ { "type": "Text", "properties": { "TextValue": "Submit", "Size": 18 } } ] }
            ]
          },
          {
            "id": "input",
            "name": "Input Field",
            "rect": { "size": [320, 36] },
            "components": [ { "type": "Image", "properties": { "Color": [0.10, 0.10, 0.12, 1] } }, { "type": "InputField" } ],
            "children": [
              { "id": "placeholder", "name": "Placeholder", "rect": { "stretch": true, "size": [-16, -8] }, "components": [ { "type": "Text", "properties": { "TextValue": "Type here...", "Size": 16 } } ] },
              { "id": "text", "name": "Text", "rect": { "stretch": true, "size": [-16, -8] }, "components": [ { "type": "Text", "properties": { "Size": 16 } } ] }
            ]
          },
          {
            "id": "row",
            "name": "Chip Row",
            "rect": { "size": [672, 40] },
            "components": [ { "type": "HorizontalLayoutGroup", "properties": { "Spacing": 8 } } ],
            "children": [
              { "id": "chipA", "name": "Chip A", "rect": { "size": [96, 32] }, "components": [ { "type": "Image", "properties": { "Color": [0.22, 0.55, 0.42, 1] } }, { "type": "Text", "properties": { "TextValue": "Image", "Size": 14 } } ] },
              { "id": "chipB", "name": "Chip B", "rect": { "size": [96, 32] }, "components": [ { "type": "Image", "properties": { "Color": [0.55, 0.40, 0.18, 1] } }, { "type": "Text", "properties": { "TextValue": "Text", "Size": 14 } } ] },
              { "id": "chipC", "name": "Chip C", "rect": { "size": [120, 32] }, "components": [ { "type": "Image", "properties": { "Color": [0.45, 0.28, 0.55, 1] } }, { "type": "Text", "properties": { "TextValue": "Layout", "Size": 14 } } ] }
            ]
          }
        ]
      }
    ]
  },
  "bindings": [
    { "node": "button", "component": "Button", "property": "TargetGraphicComponent", "targetNode": "button", "targetComponent": "Image" },
    { "node": "input", "component": "InputField", "property": "TargetGraphicComponent", "targetNode": "input", "targetComponent": "Image" },
    { "node": "input", "component": "InputField", "property": "Placeholder", "targetNode": "placeholder", "targetComponent": "Text" },
    { "node": "input", "component": "InputField", "property": "TextComponent", "targetNode": "text", "targetComponent": "Text" }
  ]
}
