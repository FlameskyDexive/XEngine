{
  "$type": "XEngine.VFX.VfxGraphAsset, XEngine.VFX.Runtime",
  "GraphName": "VFX/Burst",
  "Template": 2,
  "Capacity": 4096,
  "Properties": { "$values": [
    { "Id": "p_rate", "Name": "SpawnRate", "DisplayName": "Spawn Rate", "Type": 0, "DefaultValue": "0" },
    { "Id": "p_burst", "Name": "BurstCount", "DisplayName": "Burst Count", "Type": 0, "DefaultValue": "256" },
    { "Id": "p_dist", "Name": "SpawnOverDistance", "DisplayName": "Spawn Over Distance", "Type": 0, "DefaultValue": "0" },
    { "Id": "p_gravity", "Name": "Gravity", "DisplayName": "Gravity", "Type": 2, "DefaultValue": "0,-2,0" },
    { "Id": "p_color", "Name": "StartColor", "DisplayName": "Start Color", "Type": 4, "DefaultValue": "1,0.85,0.4,1" },
    { "Id": "p_tex", "Name": "MainTexture", "DisplayName": "Main Texture", "Type": 5, "DefaultValue": "" },
    { "Id": "p_fbx", "Name": "FlipbookColumns", "DisplayName": "Flipbook Columns", "Type": 0, "DefaultValue": "1" },
    { "Id": "p_fby", "Name": "FlipbookRows", "DisplayName": "Flipbook Rows", "Type": 0, "DefaultValue": "1" },
    { "Id": "p_colmode", "Name": "CollisionMode", "DisplayName": "Collision Mode", "Type": 0, "DefaultValue": "1" },
    { "Id": "p_colbounce", "Name": "CollisionBounce", "DisplayName": "Collision Bounce", "Type": 0, "DefaultValue": "0" },
    { "Id": "p_colplane", "Name": "CollisionPlane", "DisplayName": "Collision Plane", "Type": 3, "DefaultValue": "0,1,0,0" },
    { "Id": "p_sdfmode", "Name": "SdfCollisionMode", "DisplayName": "SDF Collision Mode", "Type": 0, "DefaultValue": "1" },
    { "Id": "p_sdfshape", "Name": "SdfShape", "DisplayName": "SDF Shape", "Type": 0, "DefaultValue": "1" },
    { "Id": "p_sdfcenter", "Name": "SdfCenter", "DisplayName": "SDF Center", "Type": 2, "DefaultValue": "0,0.55,0" },
    { "Id": "p_sdfsize", "Name": "SdfSize", "DisplayName": "SDF Size", "Type": 2, "DefaultValue": "0.4,0.4,0.4" },
    { "Id": "p_sdfvol", "Name": "SdfVolume", "DisplayName": "SDF Volume", "Type": 7, "DefaultValue": "" },
    { "Id": "p_turbi", "Name": "TurbulenceIntensity", "DisplayName": "Turbulence Intensity", "Type": 0, "DefaultValue": "0.6" },
    { "Id": "p_turbf", "Name": "TurbulenceFrequency", "DisplayName": "Turbulence Frequency", "Type": 0, "DefaultValue": "1" },
    { "Id": "p_lit", "Name": "LitMode", "DisplayName": "Lit Mode", "Type": 0, "DefaultValue": "0" },
    { "Id": "p_lightdir", "Name": "LightDirection", "DisplayName": "Light Direction", "Type": 2, "DefaultValue": "0.35,0.85,0.4" },
    { "Id": "p_lightcol", "Name": "LightColor", "DisplayName": "Light Color", "Type": 4, "DefaultValue": "1,1,1,1" },
    { "Id": "p_amb", "Name": "AmbientColor", "DisplayName": "Ambient Color", "Type": 4, "DefaultValue": "0.18,0.18,0.22,1" },
    { "Id": "p_shiny", "Name": "Shininess", "DisplayName": "Shininess", "Type": 0, "DefaultValue": "32" },
    { "Id": "p_soft", "Name": "SoftParticleFade", "DisplayName": "Soft Particle Fade", "Type": 0, "DefaultValue": "0.75" },
    { "Id": "p_evkind", "Name": "EventKind", "DisplayName": "Event Kind", "Type": 0, "DefaultValue": "1" },
    { "Id": "p_evcount", "Name": "EventCount", "DisplayName": "Event Count", "Type": 0, "DefaultValue": "3" },
    { "Id": "p_depthmode", "Name": "DepthCollisionMode", "DisplayName": "Depth Collision Mode", "Type": 0, "DefaultValue": "0" },
    { "Id": "p_conform", "Name": "ConformAttraction", "DisplayName": "Conform Attraction", "Type": 0, "DefaultValue": "0" },
    { "Id": "p_vfieldi", "Name": "VectorFieldIntensity", "DisplayName": "Vector Field Intensity", "Type": 0, "DefaultValue": "0" },
    { "Id": "p_vfield", "Name": "VectorField", "DisplayName": "Vector Field", "Type": 7, "DefaultValue": "" },
    { "Id": "p_amode", "Name": "AttributeMapMode", "DisplayName": "Attribute Map Mode", "Type": 0, "DefaultValue": "0" },
    { "Id": "p_ascale", "Name": "AttributeMapScale", "DisplayName": "Attribute Map Scale", "Type": 0, "DefaultValue": "1" },
    { "Id": "p_amap", "Name": "AttributeMap", "DisplayName": "Attribute Map", "Type": 5, "DefaultValue": "" },
    { "Id": "p_distort", "Name": "DistortionIntensity", "DisplayName": "Distortion Intensity", "Type": 0, "DefaultValue": "0" },
    { "Id": "p_plighti", "Name": "ParticleLightIntensity", "DisplayName": "Particle Light Intensity", "Type": 0, "DefaultValue": "0" },
    { "Id": "p_plightr", "Name": "ParticleLightRange", "DisplayName": "Particle Light Range", "Type": 0, "DefaultValue": "1.5" },
    { "Id": "p_plightc", "Name": "ParticleLightCount", "DisplayName": "Particle Light Count", "Type": 0, "DefaultValue": "0" }
  ] },
  "Contexts": {
    "$values": [
      { "Id": "ctx_spawn", "Type": "Spawn", "PosX": 240, "PosY": 0 },
      { "Id": "ctx_init", "Type": "Initialize", "PosX": 240, "PosY": 160 },
      { "Id": "ctx_update", "Type": "Update", "PosX": 240, "PosY": 320 },
      { "Id": "ctx_output", "Type": "OutputParticleQuad", "PosX": 240, "PosY": 480 }
    ]
  },
  "Blocks": {
    "$values": [
      { "Id": "b_burst", "ContextId": "ctx_spawn", "Type": "Burst", "Order": 0, "Fields": { "$values": [ { "Key": "Count", "Value": "256" } ] } },
      { "Id": "b_dist", "ContextId": "ctx_spawn", "Type": "SpawnOverDistance", "Order": 1, "Fields": { "$values": [ { "Key": "Rate", "Value": "0" } ] } },
      { "Id": "b_vel", "ContextId": "ctx_init", "Type": "SetVelocity", "Order": 0, "Fields": { "$values": [ { "Key": "Speed", "Value": "3" } ] } },
      { "Id": "b_color", "ContextId": "ctx_init", "Type": "SetColor", "Order": 1, "Fields": { "$values": [] } },
      { "Id": "b_size", "ContextId": "ctx_init", "Type": "SetSize", "Order": 2, "Fields": { "$values": [ { "Key": "Size", "Value": "0.2" } ] } },
      { "Id": "b_life", "ContextId": "ctx_init", "Type": "SetLifetime", "Order": 3, "Fields": { "$values": [ { "Key": "Lifetime", "Value": "1.5" } ] } },
      { "Id": "b_amap", "ContextId": "ctx_init", "Type": "AttributeMap", "Order": 4, "Fields": { "$values": [ { "Key": "Mode", "Value": "0" }, { "Key": "Scale", "Value": "1" } ] } },
      { "Id": "b_gravity", "ContextId": "ctx_update", "Type": "Gravity", "Order": 0, "Fields": { "$values": [ { "Key": "X", "Value": "0" }, { "Key": "Y", "Value": "-2" }, { "Key": "Z", "Value": "0" } ] } },
      { "Id": "b_collide", "ContextId": "ctx_update", "Type": "CollideWithPlane", "Order": 1, "Fields": { "$values": [ { "Key": "Mode", "Value": "1" }, { "Key": "Bounce", "Value": "0" }, { "Key": "Nx", "Value": "0" }, { "Key": "Ny", "Value": "1" }, { "Key": "Nz", "Value": "0" }, { "Key": "Distance", "Value": "0" } ] } },
      { "Id": "b_sdf", "ContextId": "ctx_update", "Type": "CollideWithSDF", "Order": 2, "Fields": { "$values": [ { "Key": "Mode", "Value": "1" }, { "Key": "Shape", "Value": "1" }, { "Key": "Cx", "Value": "0" }, { "Key": "Cy", "Value": "0.55" }, { "Key": "Cz", "Value": "0" }, { "Key": "Sx", "Value": "0.4" }, { "Key": "Sy", "Value": "0.4" }, { "Key": "Sz", "Value": "0.4" } ] } },
      { "Id": "b_turb", "ContextId": "ctx_update", "Type": "Turbulence", "Order": 3, "Fields": { "$values": [ { "Key": "Intensity", "Value": "0.6" }, { "Key": "Frequency", "Value": "1" } ] } },
      { "Id": "b_event", "ContextId": "ctx_update", "Type": "TriggerEvent", "Order": 4, "Fields": { "$values": [ { "Key": "Kind", "Value": "1" }, { "Key": "Count", "Value": "3" } ] } },
      { "Id": "b_depth", "ContextId": "ctx_update", "Type": "CollideWithDepth", "Order": 5, "Fields": { "$values": [ { "Key": "Mode", "Value": "0" } ] } },
      { "Id": "b_conform", "ContextId": "ctx_update", "Type": "ConformToSDF", "Order": 6, "Fields": { "$values": [ { "Key": "Attraction", "Value": "0" } ] } },
      { "Id": "b_vfield", "ContextId": "ctx_update", "Type": "VectorField", "Order": 7, "Fields": { "$values": [ { "Key": "Intensity", "Value": "0" } ] } },
      { "Id": "b_orient", "ContextId": "ctx_output", "Type": "OrientToView", "Order": 0, "Fields": { "$values": [] } },
      { "Id": "b_distort", "ContextId": "ctx_output", "Type": "Distort", "Order": 1, "Fields": { "$values": [ { "Key": "Intensity", "Value": "0" } ] } },
      { "Id": "b_plight", "ContextId": "ctx_output", "Type": "ParticleLight", "Order": 2, "Fields": { "$values": [ { "Key": "Intensity", "Value": "0" }, { "Key": "Range", "Value": "1.5" }, { "Key": "Count", "Value": "0" } ] } }
    ]
  },
  "Operators": {
    "$values": [
      { "Id": "n_color", "Type": "Color", "PosX": 40, "PosY": 160, "Fields": { "$values": [
        { "Key": "R", "Value": "1" }, { "Key": "G", "Value": "0.85" }, { "Key": "B", "Value": "0.4" }, { "Key": "A", "Value": "1" }
      ] } }
    ]
  },
  "Edges": {
    "$values": [
      { "Id": "e_flow0", "FromNode": "ctx_spawn", "FromPort": "Flow", "ToNode": "ctx_init", "ToPort": "Flow" },
      { "Id": "e_flow1", "FromNode": "ctx_init", "FromPort": "Flow", "ToNode": "ctx_update", "ToPort": "Flow" },
      { "Id": "e_flow2", "FromNode": "ctx_update", "FromPort": "Flow", "ToNode": "ctx_output", "ToPort": "Flow" },
      { "Id": "e_color", "FromNode": "n_color", "FromPort": "Out", "ToNode": "b_color", "ToPort": "Color" }
    ]
  }
}
