<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Reproducible restores: ignore machine/user feed configs (e.g. the VS offline packages
       source, which is missing on many machines and fails restore with NU1301). Everything the
       engine references lives on nuget.org. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
