    <Error Condition="!Exists('$(TargetDir)Packages\com.xengine.xgui\package.json')"
           Text="The Editor distribution is missing the built-in XGUI package manifest." />
    <Error Condition="!Exists('$(TargetDir)Packages\com.xengine.xgui\Runtime\XEngine.XGUI.Runtime.asmdef')"
           Text="The Editor distribution is missing the built-in XGUI Runtime assembly definition." />
    <Error Condition="!Exists('$(TargetDir)Packages\com.xengine.xgui\Editor\XEngine.XGUI.Editor.asmdef')"
           Text="The Editor distribution is missing the built-in XGUI Editor assembly definition." />
