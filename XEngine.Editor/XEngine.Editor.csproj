                      LogicalName="XEngine.HarmonyOS.Native.CMakeLists.txt" />
    <EmbeddedResource Include="..\XEngine.Runtime\Platforms\HarmonyOS\Native\xengine_host_napi.cpp"
                      Link="Resources\HarmonyOS\Native\xengine_host_napi.cpp"
                      LogicalName="XEngine.HarmonyOS.Native.xengine_host_napi.cpp" />
    <EmbeddedResource Include="..\XEngine.Runtime\Platforms\HarmonyOS\Native\xengine_player_abi.h"
                      Link="Resources\HarmonyOS\Native\xengine_player_abi.h"
                      LogicalName="XEngine.HarmonyOS.Native.xengine_player_abi.h" />
  </ItemGroup>

  <!-- First-party packages are part of the Editor distribution, not project dependencies.
       The glob covers every com.xengine.* package, so adding a new built-in package needs no
       csproj edit — just drop it under Packages/com.xengine.<name>/. -->
  <ItemGroup>
    <None Include="..\Packages\com.xengine.*\**\*"
          Link="Packages\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- A fresh project resolves built-in packages from the Editor distribution, so a build that omits
       any package's manifest or Runtime asmdef must fail before an unusable Editor is produced. -->
