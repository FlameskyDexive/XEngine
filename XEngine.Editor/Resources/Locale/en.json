  "about.title": "About XEngine",
  "about.tagline": "A .NET 10 / CoreCLR game engine and editor: every performance decision is driven by measured frame time, throughput, memory and GPU cost.",
  "about.render.title": "Rendering",
  "about.render.body": "Multi-backend RHI (GL/Vulkan/Metal), URP-style pipelines, Toon/outline/VFX Graph shader stack, Paper immediate-mode UI.",
  "about.anim.title": "Animation",
  "about.anim.body": "Playable-graph Animator FSM with state-machine behaviours, clip & curve editors, Timeline, 2D frame animation and Spine integration.",
  "about.sim.title": "Simulation",
  "about.sim.body": "3D physics (shape casts / CharacterController / triggers), navmesh baking & pathfinding, MagicaCloth2 cloth.",
  "about.tooling.title": "AI Tooling",
  "about.tooling.body": "xengine-cli plus an in-process MCP server: scene read/write, runtime probes, Frame Debugger, workflow DAGs — agents drive the project directly.",
  "about.pipeline.title": "Asset Pipeline",
  "about.pipeline.body": "Human-readable Echo assets, a Unity-project migration importer, FBX/texture/material importers, Addressables-style packaging.",
  "about.legal": "© {year} XEngine · MIT License · See docs/ in the repository for full documentation.",
  "menu.about": "About",
