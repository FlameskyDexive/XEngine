<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Photonic.Demo</RootNamespace>
    <AssemblyName>Photonic.Demo</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.8.2" />
    <PackageReference Include="ImGui.NET" Version="1.91.0.1" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vendored Anthology libraries (formerly external XEngine.* NuGet packages). -->
    <ProjectReference Include="..\..\..\Vector\Vector\Vector.csproj" />
    <ProjectReference Include="..\..\..\Clay\Clay\Clay.csproj" />
    <ProjectReference Include="..\..\..\Unwrapper\Unwrapper\Unwrapper.csproj" />
    <ProjectReference Include="..\..\Photonic\Photonic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Assets\Sponza\glTF\**\*.*">
      <Link>Assets\Sponza\glTF\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
