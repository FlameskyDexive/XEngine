<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(XEngineTargetFrameworks)</TargetFrameworks>
        <OutputType>Library</OutputType>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <NoWarn>8500</NoWarn> <!-- Takes the address of a managed type -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DefineConstants>$(DefineConstants);SLANG_CONSUME_GLSL</DefineConstants>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>XEngine.Slang</PackageId>

        <Description>A cross-platform managed wrapper for the Slang shader compiler. Can be used to cross-compile Slang shaders to many Graphics API shader formats.</Description>
        <PackageTags>shader compiler slang hlsl glsl shader-programs spirv spir-v Vulkan OpenGL DirectX Metal</PackageTags>

        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    </PropertyGroup>

    <PropertyGroup>
        <WindowsX64LibPath>..\Native\lib\windows-x64\bin\*.dll</WindowsX64LibPath>
        <WindowsArm64LibPath>..\Native\lib\windows-arm64\bin\*.dll</WindowsArm64LibPath>
        <LinuxX64LibPath>..\Native\lib\linux-x64\lib\*.so</LinuxX64LibPath>
        <LinuxArm64LibPath>..\Native\lib\linux-arm64\lib\*.so</LinuxArm64LibPath>
        <MacosX64LibPath>..\Native\lib\macos-x64\lib\*.dylib</MacosX64LibPath>
        <MacosArm64LibPath>..\Native\lib\macos-arm64\lib\*.dylib</MacosArm64LibPath>

        <!-- Native copy selection: the publish RID wins (cross-publishing a win-x64 editor on a
             Linux CI runner must ship .dll, not the host's .so); with no RID, fall back to the
             host OS/architecture for plain local builds. -->
        <SlangNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</SlangNativeRid>
        <SlangNativeRid Condition="'$(SlangNativeRid)' == '' AND $([MSBuild]::IsOsPlatform('Windows')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">win-x64</SlangNativeRid>
        <SlangNativeRid Condition="'$(SlangNativeRid)' == '' AND $([MSBuild]::IsOsPlatform('Windows')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">win-arm64</SlangNativeRid>
        <SlangNativeRid Condition="'$(SlangNativeRid)' == '' AND $([MSBuild]::IsOsPlatform('Linux')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">linux-x64</SlangNativeRid>
        <SlangNativeRid Condition="'$(SlangNativeRid)' == '' AND $([MSBuild]::IsOsPlatform('Linux')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">linux-arm64</SlangNativeRid>
        <SlangNativeRid Condition="'$(SlangNativeRid)' == '' AND $([MSBuild]::IsOsPlatform('OSX')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">osx-x64</SlangNativeRid>
        <SlangNativeRid Condition="'$(SlangNativeRid)' == '' AND $([MSBuild]::IsOsPlatform('OSX')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">osx-arm64</SlangNativeRid>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(WindowsX64LibPath)"
            Pack="true"
            PackagePath="runtimes/win-x64/native/" />

        <None Include="$(WindowsArm64LibPath)"
            Pack="true"
            PackagePath="runtimes/win-arm64/native/" />

        <None Include="$(LinuxX64LibPath)"
            Pack="true"
            PackagePath="runtimes/linux-x64/native/" />

        <None Include="$(LinuxArm64LibPath)"
            Pack="true"
            PackagePath="runtimes/linux-arm64/native/" />

        <None Include="$(MacosX64LibPath)"
            Pack="true"
            PackagePath="runtimes/osx-x64/native/" />

        <None Include="$(MacosArm64LibPath)"
            Pack="true"
            PackagePath="runtimes/osx-arm64/native/" />
    </ItemGroup>

    <ItemGroup Condition="'$(SlangNativeRid)' == 'win-x64'">
        <None Include="$(WindowsX64LibPath)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup Condition="'$(SlangNativeRid)' == 'win-arm64'">
        <None Include="$(WindowsArm64LibPath)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup Condition="'$(SlangNativeRid)' == 'linux-x64'">
        <None Include="$(LinuxX64LibPath)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup Condition="'$(SlangNativeRid)' == 'linux-arm64'">
        <None Include="$(LinuxArm64LibPath)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup Condition="'$(SlangNativeRid)' == 'osx-x64'">
        <None Include="$(MacosX64LibPath)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup Condition="'$(SlangNativeRid)' == 'osx-arm64'">
        <None Include="$(MacosArm64LibPath)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\COMApi\XEngine.Slang.COMApi.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <None Include="..\COMApi\bin\$(Configuration)\netstandard2.0\XEngine.Slang.COMApi.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('..\COMApi\bin\$(Configuration)\netstandard2.0\XEngine.Slang.COMApi.dll')" />
    </ItemGroup>
</Project>
